{
  "name": "ledger-core",
  "version": "1.0.0",
  "description": "In-memory account ledger core",
  "scripts": {
    "test": "bun test",
    "test:green": "bun test --path-ignore-patterns='test/failing.test.ts'",
    "typecheck": "tsc --noEmit",
    "replay": "bun run src/main.ts",
    "build": "bun build --compile src/main.ts --outfile dist/ledger-replay",
    "build:all": "bun run scripts/build-all.ts"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  }
}
